# Example ONLY. Activate after obtaining a trusted certificate for 77.42.93.209.
# Do not expose private CRM API over plain HTTP.
server {
 listen 80;
 listen [::]:80;
 server_name 77.42.93.209;
 location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
 location / { return 301 https://77.42.93.209$request_uri; }
}
server {
 listen 443 ssl;
 listen [::]:443 ssl;
 server_name 77.42.93.209;
 ssl_certificate /etc/letsencrypt/live/77.42.93.209/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/77.42.93.209/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy strict-origin-when-cross-origin always;
 root /var/www/brokerone;
 index index.html;
 location /api/ {
  proxy_pass http://127.0.0.1:8080/;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_read_timeout 15s;
  client_max_body_size 128k;
 }
 location / { try_files $uri $uri/ /index.html; }
 location ~ /\. { deny all; }
}
